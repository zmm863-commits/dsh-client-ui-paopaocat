{
  "name": "dsh-client-ui-paopaocat",
  "version": "0.3.3",
  "description": "🐱 泡泡猫玻璃主题 — 基于 Seaglass 架构的可爱蓝白 glassmorphism 主题，含淡雅/蓝色双风格切换，猫爪印、小鱼、泡泡装饰",
  "type": "module",
  "license": "MIT",
  "author": "zmm863-commits",
  "repository": {
    "type": "git",
    "url": "https://github.com/zmm863-commits/dsh-client-ui-paopaocat.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown && node build.mjs && node scripts/smoke-client.mjs",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-client.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.1.2-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.2-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.2-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1 || ^0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-theme": {
      "optional": true
    },
    "@deepseek-ai/dsh-invariants": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.7.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-cordis",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "guided",
      "adapter": "third-party",
      "failurePolicy": "manual",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "immediate",
      "dispose": "unknown"
    },
    "permissions": [
      "browser:local-storage",
      "ui:inject"
    ],
    "compatibility": {
      "dshVersions": [
        "0.2.0-rc.2"
      ]
    },
    "capability": {
      "id": "paopaocat-theme-applies",
      "kind": "ui",
      "invocation": "打开 DSH Web 界面 → 设置 → 主题，选择泡泡猫主题",
      "expected": "界面切换为泡泡猫玻璃拟态皮肤，淡雅/蓝色风格、字体与壁纸可切换"
    },
    "evidence": {
      "install": null,
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  }
}
